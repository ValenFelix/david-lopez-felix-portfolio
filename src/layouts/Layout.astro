---
import '../styles/global.css';
import { localPath, profile } from '../data/portfolio';
interface Props { title?: string; description?: string; image?: string; }
const { title = `${profile.name} — Cine / Portafolio`, description = 'El archivo cinematográfico de David López Félix, estudiante de cine.', image = 'images/david-1080.webp' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(localPath(image), Astro.site);
const hasContact = Boolean(profile.email || profile.socialLinks.length);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0B1D39" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={localPath('favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={localPath('sitemap.xml')} />
    <link rel="stylesheet" href={localPath('fonts/fonts.css')} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header container">
      <a class="wordmark" href={localPath()} aria-label="David López Félix, inicio">DLF<span>.</span></a>
      <nav aria-label="Navegación principal"><a href={localPath('#obra')}>Obra</a><a href={localPath('#sobre-mi')}>Sobre mí</a>{hasContact && <a href={localPath('#contacto')}>Contacto</a>}</nav>
    </header>
    <main id="contenido"><slot /></main>
    <footer id="contacto" class:list={['contact-footer', 'container', { 'contact-unconfigured': !hasContact }]}>
      {hasContact && <>
        <p class="eyebrow">Contacto</p>
        {profile.email ? <a class="contact-title" href={`mailto:${profile.email}`}>Hablemos de cine.<span aria-hidden="true">↗</span></a> : <h2 class="contact-title">Hablemos de cine.</h2>}
        {profile.email && <a class="contact-email" href={`mailto:${profile.email}`}>{profile.email}</a>}
      </>}
      {profile.socialLinks.length > 0 && <ul class="social-links">{profile.socialLinks.map(link => <li><a href={link.url} rel="noopener noreferrer" target="_blank">{link.label} ↗</a></li>)}</ul>}
      <div class="footer-bottom"><span>David López Félix</span><span>Cine / {new Date().getFullYear()}</span><a href={localPath()}>Volver al inicio ↑</a></div>
    </footer>
    <dialog class="cinema" aria-labelledby="cinema-title">
      <div class="cinema-header"><h2 id="cinema-title"></h2><div><button class="text-button" id="cinema-fullscreen">Pantalla completa</button><button class="text-button" id="cinema-close">Cerrar <span aria-hidden="true">×</span></button></div></div>
      <div class="cinema-screen"></div>
      <div class="cinema-footer"><p id="cinema-status" role="status">Cargando reproductor…</p><a id="cinema-external" target="_blank" rel="noopener noreferrer">Abrir en el proveedor ↗</a></div>
    </dialog>
    <script>
      import '../scripts/cinema';
    </script>
  </body>
</html>
