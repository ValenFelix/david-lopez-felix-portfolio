---
import "../styles/global.css";
import { localPath, profile } from "../data/portfolio";
import ContactDetails from "../components/ContactDetails.astro";
interface Props {
  title?: string;
  description?: string;
  image?: string;
  home?: boolean;
}
const {
  title = `${profile.name} — Cine`,
  description = "Películas y piezas audiovisuales de David López Félix.",
  image = "images/david-1080.webp",
  home = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const links = [
  { label: "Obra", path: "obra/" },
  { label: "Perfil", path: "perfil/" },
  { label: "Contacto", path: "contacto/" },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#081426" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(localPath(image), Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={localPath("favicon.svg")} type="image/svg+xml" />
    <link rel="sitemap" href={localPath("sitemap.xml")} />
    <link rel="stylesheet" href={localPath("fonts/manrope.css")} />
    <link rel="stylesheet" href={localPath("fonts/bodoni.css")} />
    <noscript
      ><style is:inline>
        .menu-toggle {
          display: none !important;
        }
        .desktop-nav {
          display: flex !important;
          gap: 16px !important;
        }
        .desktop-nav a {
          font-size: 12px;
        }
      </style></noscript
    >
    <script is:inline define:vars={{ isHome: home }}>
      try {
        const motionPreference = matchMedia("(prefers-reduced-motion: reduce)");
        if (
          isHome &&
          !sessionStorage.getItem("dlf-entered") &&
          !motionPreference.matches
        ) {
          sessionStorage.setItem("dlf-entered", "1");
          // CSS owns the 3.5 s sequence; readiness of the poster never shortens it.
          const finish = () => {
            document.documentElement.classList.remove("projection-intro");
            window.clearTimeout(safetyTimer);
            document.removeEventListener("animationend", onAnimationEnd);
            document.removeEventListener("click", onSkip);
            motionPreference.removeEventListener("change", onPreference);
            window.removeEventListener("pagehide", finish);
          };
          const onAnimationEnd = (event) => {
            if (
              event.animationName === "projection-open" &&
              event.target instanceof Element &&
              event.target.classList.contains("gate-shutter")
            )
              finish();
          };
          const onSkip = (event) => {
            if (
              event.target instanceof Element &&
              event.target.closest(".gate-skip")
            )
              finish();
          };
          const onPreference = () => {
            if (motionPreference.matches) finish();
          };
          // Emergency exit only: comfortably after the full mask has opened.
          const safetyTimer = window.setTimeout(finish, 5500);
          document.addEventListener("animationend", onAnimationEnd);
          document.addEventListener("click", onSkip);
          motionPreference.addEventListener("change", onPreference);
          window.addEventListener("pagehide", finish, { once: true });
          document.documentElement.classList.add("projection-intro");
        }
      } catch {}
    </script>
  </head>
  <body class:list={{ "home-page": home }}>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    {
      home && (
        <div class="projection-gate" aria-label="Apertura de la proyección">
          <>
            <div class="gate-shutter gate-top" />
            <div class="gate-shutter gate-bottom" />
            <div class="gate-shutter gate-left" />
            <div class="gate-shutter gate-right" />
            <div class="gate-mark" aria-hidden="true">
              <>
                <span>
                  DLF<span class="accent">.</span>
                </span>
                <small>CINE</small>
              </>
            </div>
            <button class="gate-skip" type="button">
              Omitir apertura
            </button>
          </>
        </div>
      )
    }
    <header class:list={["site-header", { "over-hero": home }]}>
      <a
        class="wordmark"
        href={localPath()}
        aria-label="DLF. — David López Félix, inicio">DLF<span>.</span></a
      >
      <nav class="desktop-nav" aria-label="Navegación principal">
        {
          links.map((link) => (
            <a
              href={localPath(link.path)}
              aria-current={
                Astro.url.pathname.endsWith(`/${link.path}`)
                  ? "page"
                  : undefined
              }
            >
              {link.label}
            </a>
          ))
        }
      </nav>
      <button
        class="menu-toggle"
        aria-haspopup="dialog"
        aria-controls="mobile-menu"
        >Menú <span aria-hidden="true">☰</span></button
      >
    </header>
    <dialog id="mobile-menu" class="mobile-menu" aria-label="Menú principal">
      <div class="menu-top">
        <span class="wordmark">DLF<span>.</span></span><button
          id="menu-close"
          class="text-button">Cerrar ×</button
        >
      </div><nav aria-label="Navegación móvil">
        {links.map((link) => <a href={localPath(link.path)}>{link.label}</a>)}
      </nav><a
        class="menu-instagram"
        href={profile.socialLinks[0].url}
        target="_blank"
        rel="noopener noreferrer">Instagram / {profile.socialLinks[0].label}</a
      >
    </dialog>
    <main id="contenido"><slot /></main>
    <footer class="site-footer container">
      <div class="footer-top">
        <a href={localPath("contacto/")} class="footer-invitation"
          >Hablemos<br />de cine<span class="accent">.</span></a
        ><ContactDetails />
      </div>
      <div class="footer-bottom">
        <a href={localPath()}>David López Félix</a><span
          >Cine / {new Date().getFullYear()}</span
        ><a href="#contenido">Volver arriba</a>
      </div>
    </footer>
    <dialog class="cinema" aria-labelledby="cinema-title">
      <div class="cinema-header">
        <h2 id="cinema-title"></h2><div>
          <button class="text-button" id="cinema-fullscreen"
            >Pantalla completa</button
          ><button class="text-button" id="cinema-close"
            >Cerrar <span aria-hidden="true">×</span></button
          >
        </div>
      </div>
      <div class="cinema-screen"></div>
      <div class="cinema-footer">
        <p id="cinema-status" role="status">Cargando reproductor…</p><a
          id="cinema-external"
          target="_blank"
          rel="noopener noreferrer">Abrir en el proveedor</a
        >
      </div>
    </dialog>
    <script>
      import "../scripts/cinema";
      import "../scripts/motion";
    </script>
  </body>
</html>
