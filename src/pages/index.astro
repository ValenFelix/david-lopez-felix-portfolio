---
import Layout from "../layouts/Layout.astro";
import ProjectEntry from "../components/ProjectEntry.astro";
import { projects, localPath } from "../data/portfolio";
const selected = ["comezon", "mujer-muneca", "azul"].map(
  (slug) => projects.find((project) => project.slug === slug)!,
);
---

<Layout home image="images/rework/hero-1280.webp">
  <section class="cinematic-hero" aria-labelledby="identity">
    <div class="hero-picture">
      <img
        class="hero-poster"
        src={localPath("images/rework/hero-1280.webp")}
        srcset={`${localPath("images/rework/hero-640.webp")} 640w, ${localPath("images/rework/hero-1280.webp")} 1280w`}
        sizes="100vw"
        width="1280"
        height="720"
        alt="Un joven en una habitación iluminada por una lámpara cálida, fotograma de Azul."
        fetchpriority="high"
      />
      <video
        class="hero-loop"
        data-mobile={localPath("media/hero-mobile.mp4")}
        data-desktop={localPath("media/hero-desktop.mp4")}
        muted
        loop
        playsinline
        preload="none"
        aria-hidden="true"></video>
    </div>
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="hero-identity">
      <p class="eyebrow">David López Félix / Cine</p><h1 id="identity">
        <span>DAVID</span><span>LÓPEZ FÉLIX</span>
      </h1>
    </div>
    <a class="hero-access" href={localPath("obra/")}
      ><span>Explorar <br />la obra</span><span
        class="round-arrow"
        aria-hidden="true">↗</span
      ></a
    >
    <div class="hero-bottom">
      <span class="hero-caption-label">Imágenes del archivo</span><button
        class="hero-pause"
        hidden>Pausar imagen Ⅱ</button
      ><a href="#seleccion" aria-label="Ir a la selección de obras">↓</a>
    </div>
  </section>
  <section id="seleccion" class="home-selection container">
    <div class="selection-heading">
      <p class="eyebrow">Una selección</p><h2>
        Historias que<br /><span>habitan la imagen.</span>
      </h2>
    </div>
    <div class="selected-works">
      {
        selected.map((project, index) => (
          <ProjectEntry project={project} index={index} />
        ))
      }
    </div>
    <a class="all-work" href={localPath("obra/")}
      ><span>Ver toda la obra</span><span aria-hidden="true">↗</span></a
    >
  </section>
</Layout>
