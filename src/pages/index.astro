---
import Layout from '../layouts/Layout.astro';
import ProjectEntry from '../components/ProjectEntry.astro';
import { projects, featured, profile, localPath } from '../data/portfolio';
---
<Layout>
  <section class="hero container" aria-labelledby="identity">
    <div class="hero-topline"><p class="eyebrow"><span class="orange-square" aria-hidden="true"></span>Cine / Portafolio</p><a class="explore" href="#obra">Explorar obra <span aria-hidden="true">↘</span></a></div>
    <h1 id="identity">DAVID <span>LÓPEZ FÉLIX</span></h1>
    {featured.poster ? <>
      <a class="hero-image" href={localPath(`trabajos/${featured.slug}/`)} aria-label={`Ver ficha de ${featured.title}`}><img src={localPath(featured.poster)} srcset={`${localPath('images/pieza-640.webp')} 640w, ${localPath('images/pieza-1280.webp')} 1280w, ${localPath('images/pieza-1920.webp')} 1920w`} sizes="(max-width: 1440px) 92vw, 1320px" alt={featured.posterAlt ?? `Fotograma de ${featured.title}`} width="1920" height="1080" fetchpriority="high" /></a>
      <div class="hero-caption"><span class="project-number">01 /</span><div><h2>{featured.title}</h2><p class="small muted">Título por confirmar</p></div><a class="text-link" href={localPath(`trabajos/${featured.slug}/`)}>Ver ficha <span aria-hidden="true">↗</span></a></div>
    </> : <div class="hero-intro"><p>Un archivo de cine.</p><p>La obra de David López Félix.</p></div>}
  </section>
  <section class="archive" id="obra" aria-labelledby="archive-title">
    <div class="container">
      <div class="section-heading"><h2 id="archive-title">Obra seleccionada</h2><span class="eyebrow">{String(projects.length).padStart(2, '0')} trabajos</span></div>
      <div class="project-grid">{projects.map((project, index) => <ProjectEntry project={project} index={index} />)}</div>
      {projects.some(project => !project.titleConfirmed) && <p class="archive-note">Títulos de trabajo a partir del material facilitado.</p>}
    </div>
  </section>
  <section class="about container" id="sobre-mi" aria-labelledby="about-title">
    <div class="about-image"><img src={localPath('images/david-1080.webp')} srcset={`${localPath('images/david-640.webp')} 640w, ${localPath('images/david-1080.webp')} 1080w, ${localPath('images/david-1600.webp')} 1600w`} sizes="(max-width: 700px) calc(100vw - 40px), 52vw" width="2160" height="1414" loading="lazy" alt="David López Félix junto a un lago, con el bosque al fondo." /></div>
    <div class="about-copy"><p class="eyebrow">Sobre mí</p><h2 id="about-title">David López Félix</h2><p>{profile.biography}</p><span class="about-rule" aria-hidden="true"></span></div>
  </section>
</Layout>
