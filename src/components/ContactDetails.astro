---
import { profile } from "../data/portfolio";
---

<div class="contact-details">
  <div>
    <span class="eyebrow">Instagram</span><a
      href={profile.socialLinks[0].url}
      target="_blank"
      rel="noopener noreferrer">{profile.socialLinks[0].label}</a
    >
  </div>
  <div>
    <span class="eyebrow">Correo</span>{
      profile.emailProvisional ? (
        <span class="email-address">{profile.email}</span>
      ) : (
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
      )
    }
  </div>
</div>
